---
import Main from "@/layouts/main.astro"
import ProjectGrid from "@/components/shared/ProjectGrid"
import { getProjectItems } from "@/lib/projects"

const items = await getProjectItems()
---
<Main
  title="Projects | Ahmad Fauzan"
  description="All projects built by Ahmad Fauzan with Laravel, Go, and React."
>
  <section class="mx-auto max-w-5xl px-6 py-24" aria-labelledby="all-projects-title">
    <a href="/" class="text-sm text-muted-foreground transition-colors duration-200 hover:text-foreground">
      Back to home
    </a>
    <h1 id="all-projects-title" class="mt-6 text-4xl font-semibold tracking-tight">
      All projects
    </h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">Everything I’ve built, newest first.</p>
    <div class="mt-12">
      <ProjectGrid items={items} client:visible />
    </div>
  </section>
</Main>