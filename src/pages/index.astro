---
import "../styles/global.css";
import { getCollection } from "astro:content"
// Component Imports
import Hero from "@/components/sections/hero";
import Main from "@/layouts/main.astro";
import Projects from "@/components/sections/projects"
import { getProjectItems } from "@/lib/projects"
import DotField from "@/components/shared/DotField";

const projects = await getProjectItems(6)
---

<Main
  title="Ahmad Fauzan Setyo Wicaksono - Software Engineer"
  description="Software Engineer building reliable web apps with Laravel, Go, and React. Explore my projects and get in touch."
>
  <div class="relative isolate -mt-14 overflow-hidden pt-14">
    <DotField client:load />
    <Hero />
  </div>
	<Projects items={projects} client:visible />
</Main>
