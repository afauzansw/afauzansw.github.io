---
import "../styles/global.css";

// Component Imports
import Main from "@/layouts/main.astro";
import Hero from "@/components/sections/hero";
import Projects from "@/components/sections/projects"
import Experience from "@/components/sections/experience"
import Contact from "@/components/sections/contact"
import Footer from "@/components/sections/footer"
import About from "@/components/sections/about"
import { about } from "@/data/about"
import { getProjectItems } from "@/lib/projects"
import { getExperienceItems } from "@/lib/experiences"
import DotField from "@/components/shared/DotField";

const projects = await getProjectItems(6)
const experiences = await getExperienceItems()
---

<Main
  title="Ahmad Fauzan Setyo Wicaksono - Software Engineer"
  description="Software Engineer building reliable web apps with Laravel, Go, and React. Explore my projects and get in touch."
>
  <div class="relative isolate -mt-14 overflow-hidden pt-14">
    <DotField client:load />
    <Hero />
  </div>
  <About {...about} client:visible />
	<Projects items={projects} client:visible />
  <Experience items={experiences} client:visible/>
  <Contact client:visible/>
  <Footer/>
</Main>
