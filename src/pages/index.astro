---
import "../styles/global.css";
import { getCollection } from "astro:content"
// Component Imports
import Hero from "@/components/sections/hero";
import Main from "@/layouts/main.astro";
import Projects from "@/components/sections/projects"
import { getProjectItems } from "@/lib/projects"

const projects = await getProjectItems(6)
---

<Main
  title="Ahmad Fauzan Setyo Wicaksono - Fullstack Developer"
  description="Fullstack developer building reliable web apps with Laravel, Go, and React. Explore my projects and get in touch."
>
  <Hero />
	<Projects items={projects} client:visible />
</Main>
